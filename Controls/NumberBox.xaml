<UserControl x:Class="XivToolsWpf.Controls.NumberBox"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:local="clr-namespace:XivToolsWpf.Controls"
			 mc:Ignorable="d" 
			 d:DesignWidth="128"
			 Height="24"
			 HorizontalAlignment="Stretch"
			 Loaded="OnLoaded"
			 Unloaded="OnUnloaded">

	<UserControl.Resources>
		<ControlTemplate x:Key="SliderTemplate" TargetType="Control">
			<Slider
				Style="{StaticResource AnaSlider}"
				Margin="3, 0, 3, 0"
				HorizontalAlignment="Stretch"
				Value="{Binding SliderValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
				Minimum="{Binding SliderMinimum}"
				Maximum="{Binding SliderMaximum}"
				TickFrequency="{Binding TickFrequency}"
				IsSnapToTickEnabled="True"
				IsMoveToPointEnabled="{Binding IsAbsoluteSlider, Mode=OneWay}"
				Focusable="False"
				VerticalAlignment="Center"
				PreviewMouseMove="OnSliderMouseMove"
				PreviewMouseDown="OnSliderPreviewMouseDown"
				PreviewMouseUp="OnSliderPreviewMouseUp"/>
		</ControlTemplate>

		<ControlTemplate x:Key="ButtonsTemplate" TargetType="Control">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition/>
					<ColumnDefinition/>
				</Grid.ColumnDefinitions>

				<RepeatButton Grid.Column="0" Content="-" Style="{StaticResource TransparentRepeatButton}" Padding="1" Click="OnDownClick" Width="20" HorizontalContentAlignment="Center" Margin="4,1,1,1"/>
				<RepeatButton Grid.Column="1" Content="+" Style="{StaticResource TransparentRepeatButton}" Padding="1" Click="OnUpClick" Width="20" HorizontalContentAlignment="Center" Margin="1,1,0,1"/>
			</Grid>
		</ControlTemplate>
	</UserControl.Resources>

	<Grid x:Name="ContentArea">
		<Grid.ColumnDefinitions>
			<ColumnDefinition x:Name="SliderArea" Width="0"/>
			<ColumnDefinition x:Name="InputBoxArea" Width="*" MinWidth="16"/>
			<ColumnDefinition Width="Auto"/>
		</Grid.ColumnDefinitions>

		<Control Grid.Row="0" Grid.Column="0" Focusable="False">
			<Control.Style>
				<Style TargetType="Control">
					<Style.Triggers>
						<DataTrigger Binding="{Binding Slider}" Value="{x:Static local:NumberBox+SliderModes.Absolute}">
							<Setter Property="Template" Value="{StaticResource SliderTemplate}"/>
						</DataTrigger>
						<DataTrigger Binding="{Binding Slider}" Value="{x:Static local:NumberBox+SliderModes.Relative}">
							<Setter Property="Template" Value="{StaticResource SliderTemplate}"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Control.Style>
		</Control>

		<TextBox
			x:Name="InputBox"
			Grid.Row="0"
			Grid.Column="1"
			Style="{StaticResource AnaCompactTextBox}"
			Foreground="{DynamicResource MaterialDesignBody}"
			Text="{Binding Text, UpdateSourceTrigger=PropertyChanged, FallbackValue=000.000}"
			LostFocus="OnLostFocus"
			Margin="0, 0, 0, 0"
			Padding="0, 4, 0, 0"
			LostKeyboardFocus="OnLostFocus"/>

		<Line
			Visibility="Collapsed"
			x:Name="ErrorDisplay"
			Grid.Column="1"
			X1="0"
			X2="1"
			VerticalAlignment="Bottom"
			HorizontalAlignment="Stretch"
			Stretch="Fill"
			StrokeThickness="1"
			Stroke="Red"
			Margin="0,0,0,0"/>

		<Control Grid.Column="2" Focusable="False">
			<Control.Style>
				<Style TargetType="Control">
					<Style.Triggers>
						<DataTrigger Binding="{Binding Buttons}" Value="True">
							<Setter Property="Template" Value="{StaticResource ButtonsTemplate}"/>
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Control.Style>
		</Control>
	</Grid>
</UserControl>
