<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Based on MaterialDesign.Themes v4.0.0: https://github.com/MaterialDesignInXAML/MaterialDesignInXamlToolkit/blob/v4.0.0/MaterialDesignThemes.Wpf/Themes/MaterialDesignTheme.Slider.xaml -->
	<!-- MaterialDesign.Themes v4.1.0 updated the slider design to be thicker with larger slider thumb and I don't like it -->
	<Style x:Key="AnaSliderRepeatButton" TargetType="{x:Type RepeatButton}">
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Background" Value="Transparent"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="IsTabStop" Value="False"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type RepeatButton}">
					<Grid Background="Transparent" Height="16" Cursor="Hand">
						<Border Height="2" VerticalAlignment="Center" CornerRadius="1" Background="{TemplateBinding Background}"/>
					</Grid>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="AnaSliderThumb" TargetType="{x:Type Thumb}">
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Focusable" Value="False"/>
		<Setter Property="Width" Value="12"/>
		<Setter Property="Height" Value="16"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Cursor" Value="Hand"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Thumb}">
					<Grid Background="Transparent" ClipToBounds="False">
						<Ellipse x:Name="Halo" Width="20" Height="20" Margin="-4, -2" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}" Opacity="0" IsHitTestVisible="False"/>
						<Ellipse x:Name="Grip" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{TemplateBinding Foreground}"/>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Halo" Property="Opacity" Value="0.2"/>
						</Trigger>
						<Trigger Property="IsDragging" Value="True">
							<Setter TargetName="Halo" Property="Opacity" Value="0.3"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

	<Style x:Key="AnaSlider" TargetType="{x:Type Slider}">
		<Setter Property="OverridesDefaultStyle" Value="True"/>
		<Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}"/>
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="{x:Type Slider}">
					<Grid x:Name="Root" VerticalAlignment="Center">
						<Track x:Name="PART_Track">
							<Track.DecreaseRepeatButton>
								<RepeatButton Command="{x:Static Slider.DecreaseLarge}"
											  Style="{StaticResource AnaSliderRepeatButton}"
											  Background="{TemplateBinding Foreground}"/>
							</Track.DecreaseRepeatButton>
							<Track.IncreaseRepeatButton>
								<RepeatButton Command="{x:Static Slider.IncreaseLarge}"
											  Style="{StaticResource AnaSliderRepeatButton}"
											  Background="{DynamicResource MaterialDesignBodyLight}"
											  Opacity="0.45"/>
							</Track.IncreaseRepeatButton>
							<Track.Thumb>
								<Thumb x:Name="Thumb" Style="{StaticResource AnaSliderThumb}" Foreground="{TemplateBinding Foreground}"/>
							</Track.Thumb>
						</Track>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsEnabled" Value="False">
							<Setter TargetName="Root" Property="Opacity" Value="0.4"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>
</ResourceDictionary>
